# ── Required ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_SITE_URL=https://www.mulberryempire.com
RESEND_API_KEY=re_...

# ── Accounts (sign-in, synced bag, order history) ──────────────────────────
# Vercel → Storage → Upstash for Redis adds these automatically. Without them
# the site still works; accounts just show "coming soon".
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Store mode ──────────────────────────────────────────────────────────────
# waitlist (default, no payment taken) | preorder | live
NEXT_PUBLIC_STORE_MODE=waitlist
# Required for preorder mode, e.g. "March 2027". Pre-orders stay closed without it.
NEXT_PUBLIC_PREORDER_SHIP_ESTIMATE=
# Required before selling: e.g. "Portugal" or "USA" (Textile Act origin disclosure).
NEXT_PUBLIC_COUNTRY_OF_ORIGIN=
# Comma-separated ISO codes. Keep US-only until you've handled foreign VAT/GST.
NEXT_PUBLIC_SHIPPING_COUNTRIES=US

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GOVERNING_STATE=
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false
STRIPE_SHIPPING_RATE_IDS=
RESEND_WAITLIST_SEGMENT_ID=
RESEND_NEWSLETTER_SEGMENT_ID=
